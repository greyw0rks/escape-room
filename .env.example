# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
# Never commit a real key. For production, set these in Vercel:
#   Project → Settings → Environment Variables (Production + Preview)
#
# NOTE: no NEXT_PUBLIC_ prefix on the key. Anything prefixed NEXT_PUBLIC_ is
# inlined into the client bundle and would be readable by every player.

# ── AI (Google Gemini) ──────────────────────────────────────────────────────
# Get one at https://aistudio.google.com/apikey
# Used server-side only, for hint generation, NPC dialogue and nightly room
# generation. The game must stay fully playable when this is unset — the seed
# room and scripted hints are the fallback path.
GEMINI_API_KEY=

# Text model for hints/NPC dialogue. Chosen for request-per-day headroom
# rather than raw quality: hints are short and heavily prompt-constrained.
#   gemini-3.1-flash-lite  15 RPM / 250K TPM / 500 RPD   <- default
#   gemini-3.6-flash        5 RPM / 250K TPM /  20 RPD   <- better prose, tiny RPD
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Image model for room art. Leave blank to use the hand-authored SVG art,
# which is the default and costs nothing.
#   imagen-4-fast-generate  25 images/day
GEMINI_IMAGE_MODEL=

# ── Chain ───────────────────────────────────────────────────────────────────
# Defaults resolve per-network in lib/contract.ts; override only to point at
# a different deployment.
# NEXT_PUBLIC_CELO_NETWORK=testnet
# NEXT_PUBLIC_POOL_ADDRESS=

# Backend key that signs winner claims. Server-side only — this key authorises
# withdrawals from a day's prize pool and must NEVER be committed or exposed
# to the client. Keep it distinct from the contract owner key.
SETTLEMENT_SIGNER_PRIVATE_KEY=
