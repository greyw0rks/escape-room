# Copy to `.env` (same directory) and fill in. `.env` is gitignored — `.env.example` is not.
# Load it with:  set -a && source .env && set +a
#
# ⚠️  Use a THROWAWAY key that has only ever held testnet funds.
#     Do not reuse a key that holds real money on any chain.

# Deployer. Becomes the owner unless OWNER_ADDRESS is set below.
# Needs ~0.26 CELO on Celo Sepolia: https://faucet.celo.org/celo-sepolia
PRIVATE_KEY=0x

# Backend key that authorises claims. This is an ADDRESS, not a private key —
# the matching private key belongs in the host env (Vercel), never in this repo.
# Must differ from the owner: sharing it would mean a leaked backend key also
# hands over the treasury. The deploy script refuses to run if they match.
SIGNER_ADDRESS=0x

# Optional
# OWNER_ADDRESS=0x
# RAKE_BPS=500          # 5%; hard-capped at 2000 (20%) in the contract
# CLAIM_WINDOW=2592000  # 30 days before unclaimed prizes may be swept

# Optional, for `--verify` on Celoscan
# CELOSCAN_API_KEY=
